[Unit]
Description=Private shared Codex app server for %i
Documentation=https://github.com/jesse-merhi/cxa
After=network-online.target
After=cxa-service-guard@%i.service
Wants=network-online.target
Requires=cxa-service-guard@%i.service

[Service]
Type=simple
User=%i
EnvironmentFile=/etc/cxa/%i.env
Environment=CXA_ACTIVE_AUTH=/var/lib/codex-auth/auth.json
Environment=CXA_SHARED_APP_SERVER_SOCKET=/var/lib/codex-auth/app-server.sock
Environment=CODEX_REFRESH_TOKEN_URL_OVERRIDE=http://127.0.0.1:0/cxa-refresh-disabled
ExecStartPre=+/usr/local/libexec/codex-shared-socket prepare %i
ExecStart=/usr/bin/env ${CXA_CODEX_BIN} -c 'cli_auth_credentials_store="file"' app-server --listen unix:///var/lib/codex-auth/app-server.sock
ExecStartPost=+/usr/local/libexec/codex-shared-socket publish %i ${MAINPID}
ExecStartPost=/bin/sh -c 'CXA_SKIP_USAGE_REFRESH=1 exec "$CXA_CLI_BIN" service-release'
ExecStopPost=+/usr/local/libexec/codex-shared-socket recover-owner %i
ExecStopPost=/bin/sh -c 'CXA_SKIP_USAGE_REFRESH=1 exec "$CXA_CLI_BIN" service-release'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
